---
// Упрощённый знак для размеров меньше 32 px (07 · Scale & Pixels).
interface Props { size?: number; class?: string }
const { size = 24, class: cls } = Astro.props;
---
<svg class:list={['vl-mini', cls]} viewBox="0 0 200 200" width={size} height={size} aria-hidden="true">
  <rect x="24" y="24" width="152" height="152" rx="30" fill="none" stroke="currentColor" stroke-width="12" transform="rotate(20 100 100)" />
  <circle cx="100" cy="100" r="54" fill="currentColor" />
</svg>
