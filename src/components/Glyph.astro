---
// Глиф территории: рисуется из файла /brand/glyphs/<name>.svg через mask,
// чтобы брать цвет из currentColor.
interface Props { name: string; size?: number; class?: string }
const { name, size = 32, class: cls } = Astro.props;
---
<span class:list={['vl-glyph', cls]} style={`--g:url(/brand/glyphs/${name}.svg);width:${size}px;height:${size}px`} aria-hidden="true"></span>
